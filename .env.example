# Замените значения паролей перед первым запуском Docker Compose.
LEGACY_DB__HOST=127.0.0.1
LEGACY_DB__PORT=55432
LEGACY_DB__NAME=legacy_crm
LEGACY_DB__USER=legacy_reader
LEGACY_DB__PASSWORD=replace-legacy-reader-password
LEGACY_DB_ADMIN_USER=legacy_admin
LEGACY_DB_ADMIN_PASSWORD=replace-legacy-admin-password

TARGET_DB__HOST=127.0.0.1
TARGET_DB__PORT=55433
TARGET_DB__NAME=target_crm
TARGET_DB__USER=target_writer
TARGET_DB__PASSWORD=replace-target-writer-password
TARGET_DB_ADMIN_USER=target_admin
TARGET_DB_ADMIN_PASSWORD=replace-target-admin-password

DB_TIMEOUT_SECONDS=5
MIGRATION_LAB_MODE=false

# Опциональный профиль monitoring.
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-grafana-admin-password
METRICS_DB_TIMEOUT_SECONDS=4
# METRICS_TARGET_DB_USER=target_metrics_reader
# METRICS_TARGET_DB_PASSWORD=replace-target-metrics-reader-password
